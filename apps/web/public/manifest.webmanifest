{
  "id": "/",
  "name": "Magic3D - CAD gratuit pentru printare 3D",
  "short_name": "Magic3D",
  "description": "CAD 3D gratuit pentru printare 3D, direct în browser",
  "lang": "ro",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.layerling.project+zip": [
          ".lyl"
        ]
      }
    }
  ],
  "orientation": "any",
  "background_color": "#fafafa",
  "theme_color": "#fafaf9",
  "categories": [
    "graphics",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "assets/magic3d/magic3d-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/magic3d/magic3d-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/magic3d/magic3d-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/magic3d/magic3d-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
