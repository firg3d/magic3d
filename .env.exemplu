# Datele de conectare pentru `npm run publica`.
#
# Copiază fișierul ăsta în `.env` și completează valorile. `.env` e în .gitignore
# și nu trebuie să ajungă NICIODATĂ în depozit: conține parola contului de hosting.
#
# Le găsești în cPanel → FTP Accounts. Folosește un cont FTP dedicat, limitat la
# public_html, nu contul principal de cPanel: dacă scapă, pierzi mai puțin.

PUBLICA_GAZDA=ftp.magic3d.ro
PUBLICA_UTILIZATOR=
PUBLICA_PAROLA=
PUBLICA_PORT=21

# Directorul RĂDĂCINĂ al site-ului pe server, de obicei /public_html
PUBLICA_DIRECTOR=/public_html

# Lasă gol. Scriptul folosește implicit FTPS (TLS explicit), deci parola nu circulă
# în clar. Pune `da` DOAR dacă serverul refuză TLS și nu ai altă cale — și cere
# atunci acces SSH/SFTP de la găzduire.
PUBLICA_NESECURIZAT=
